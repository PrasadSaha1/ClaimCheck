# Copy this file to backend/.env and paste your Google AI Studio API key below.
# Never put this key in frontend/.env or prefix it with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional local overrides:
# DJANGO_SECRET_KEY=replace-for-non-demo-deployments
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
